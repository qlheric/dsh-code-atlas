{
  "name": "@qlheric/dsh-code-atlas",
  "version": "0.1.0",
  "description": "DSH 代码图谱：tree-sitter WASM 符号索引 + 每文件一行 F/R/A/S 认知层（职责/关系/入口/硬约束），给 agent 一张可核的仓库地图。",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-index",
    "tree-sitter",
    "repo-map",
    "symbols",
    "code-search"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "scripts": {
    "test": "node --test"
  },
  "meta": {
    "title": "DSH 代码图谱（Code Atlas）",
    "description": "tree-sitter WASM 符号索引 + 仓库地图 + 每文件一行 F/R/A/S 认知层（F 职责 / R 关系 / A 入口 / S 不能弄错的约束），零原生编译。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "profiles": [
        "web",
        "desktop"
      ]
    }
  }
}
